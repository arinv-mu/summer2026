# Git ignore rules for multi-language project

# ==================== PYTHON ====================
*.py[cod]
__pycache__/
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
.pytest_cache/
.coverage
.mypy_cache/
*.egg
*.whl

# ==================== JAVA ====================
*.class
*.jar
*.war
target/
build/
dist/
.gradle/
*.gradle.kts
.classpath
.project
.settings/
*.iml
.idea/

# ==================== C/C++ ====================
*.o
*.a
*.out
*.exe
*.so
*.dylib
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
build/
.vscode/
*.dSYM/
*.su
*.gch
vgcore.*

# C/C++ compiled binaries (executables without extensions)
03-semester-c/01-coursework/*/[!.]*
03-semester-c/04-LEARNING-MATERIALS/03-exercises/*/*
!03-semester-c/**/*.c
!03-semester-c/**/*.h
!03-semester-c/**/*.md
!03-semester-c/**/CMakeLists.txt
!03-semester-c/**/Makefile*

04-semester-cpp/01-coursework/*/[!.]*
04-semester-cpp/04-LEARNING-MATERIALS/**/*
!04-semester-cpp/**/*.cpp
!04-semester-cpp/**/*.h
!04-semester-cpp/**/*.md
!04-semester-cpp/**/CMakeLists.txt

# ==================== GENERAL ====================
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~
.vscode/
.idea/
*.log
*.code-workspace
node_modules/
package-lock.json

# ==================== SEMESTER-SPECIFIC ====================
# Python venv per semester
01-semester-python/venv/
01-semester-python/.venv/

# Java build outputs
02-semester-java/build/
02-semester-java/.gradle/

# C build outputs
03-semester-c/build/

# C++ build outputs
04-semester-cpp/build/

# IDE and Editor configurations
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
